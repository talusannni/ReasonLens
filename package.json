{
  "name": "reasonlens",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:provenance && npm run test:quality-gates && npm run test:evaluation && npm run test:evidence-diff && npm run test:trace-execution && npm run test:trace-comparison && npm run test:evaluation-regression && npm run test:experiment-analysis && npm run test:api-security && npm run test:security-integrity && npm run test:tenant-isolation",
    "test:ci": "npm test && npm run build",
    "test:provenance": "npx --yes tsx scripts/test-provenance-regression.ts",
    "test:quality-gates": "npx --yes tsx scripts/test-quality-gates.ts",
    "test:evaluation": "npx --yes tsx scripts/test-evaluation.ts",
    "test:evidence-diff": "npx --yes tsx scripts/test-evidence-diff.ts",
    "test:trace-execution": "npx --yes tsx scripts/test-trace-execution.ts",
    "test:evaluation-regression": "npx --yes tsx scripts/test-evaluation-regression.ts",
    "test:experiment-analysis": "npx --yes tsx scripts/test-experiment-analysis.ts",
    "test:api-security": "npx --yes tsx scripts/test-api-security.ts",
    "test:security-integrity": "npx --yes tsx scripts/test-security-integrity.ts",
    "test:security-live": "node scripts/test-security-live.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "workspace:create-key": "node scripts/create-workspace-api-key.mjs",
    "test:tenant-isolation": "npx --yes tsx scripts/test-tenant-isolation.ts",
    "test:trace-comparison": "npx --yes tsx scripts/test-trace-comparison.ts"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  }
}
